generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(FOUNDER)
  company       String?
  industry      String?
  country       String?
  language      String?   @default("en")
  streakDays    Int       @default(0)
  lastActiveDate DateTime?
  founderScore  Int       @default(0)
  digestMode    Boolean   @default(false)
  alertIndustry String?
  onboarded     Boolean   @default(false)
  publicProfile Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  decisions  Decision[]
  alerts     Alert[]
  roomMembers RoomMember[]
  messages   Message[]
  compassSessions   CompassSession[]
  pitchBuilds       PitchBuild[]
  onePagers         OnePager[]
  investorEmails    InvestorEmail[]
  ideaValidations   IdeaValidation[]
  cofounderProfile    CofounderProfile?
  pitchMirrorSessions     PitchMirrorSession[]
  founderChats            FounderChat[]
  customerSearches        CustomerSearch[]
  coldEmailCampaigns      ColdEmailCampaign[]
  pitchCoachLiveSessions  PitchCoachLiveSession[]
}

enum UserRole {
  FOUNDER
  INVESTOR
  EXECUTIVE
}

enum UserPlan {
  FREE_TRIAL
  PRO
  MAX
  PREMIUM
}

model PlanUsage {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  plan                    String   @default("FREE_TRIAL")
  planSince               DateTime @default(now())
  decisionsThisMonth      Int      @default(0)
  mentorRequestsThisMonth Int      @default(0)
  alertsCount             Int      @default(0)
  resetAt                 DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Decision {
  id             String         @id @default(cuid())
  userId         String
  title          String
  description    String         @db.Text
  type           DecisionType   @default(GENERAL)
  status         DecisionStatus @default(PENDING)
  riskScore      Int?
  recommendation String?
  report         Json?
  marketData     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal  DecisionJournal?
  outcomes DecisionOutcome[]
}

model DecisionJournal {
  id              String    @id @default(cuid())
  decisionId      String    @unique
  userId          String
  why             String?   @db.Text
  biggestFear     String?   @db.Text
  keyAssumption   String?   @db.Text
  expectedOutcome String?   @db.Text
  deadline        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

model DecisionOutcome {
  id         String        @id @default(cuid())
  decisionId String
  userId     String
  daysAfter  Int
  result     OutcomeResult
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

enum OutcomeResult {
  SUCCEEDED
  FAILED
  PARTIAL
  ONGOING
}

model BlindSpot {
  id             String   @id @default(cuid())
  userId         String
  pattern        String
  severity       String
  supportCount   Int      @default(0)
  recommendation String   @db.Text
  lastUpdated    DateTime @default(now())

  @@unique([userId, pattern])
}

model MarketSignal {
  id               String   @id @default(cuid())
  userId           String
  title            String
  summary          String   @db.Text
  impact           String
  relatedDecisions String[]
  category         String
  createdAt        DateTime @default(now())
}

enum DecisionType {
  MARKET_ENTRY
  HIRING
  FUNDRAISING
  PIVOT
  PARTNERSHIP
  DEAL_EVALUATION
  MARKET_TIMING
  PORTFOLIO
  RISK
  EXIT
  EXPANSION
  ACQUISITION
  RESTRUCTURING
  COST_CUTTING
  GENERAL
}

enum DecisionStatus {
  PENDING
  ANALYZING
  COMPLETE
  ARCHIVED
}

model Alert {
  id           String      @id @default(cuid())
  userId       String
  topic        String
  keywords     String[]
  frequency    AlertFreq   @default(DAILY)
  active       Boolean     @default(true)
  lastFired    DateTime?
  triggerCount Int         @default(0)
  templateId   String?
  createdAt    DateTime    @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  history AlertHistory[]
}

model AlertHistory {
  id          String   @id @default(cuid())
  alertId     String
  userId      String
  headline    String
  summary     String   @db.Text
  source      String
  url         String?
  isRead      Boolean  @default(false)
  triggeredAt DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model PitchMirrorSession {
  id             String   @id @default(cuid())
  userId         String
  startupName    String
  audienceType   String
  pitchType      String
  targetDuration Int
  actualDuration Int      @default(0)
  mode           String   @default("video")
  transcript     String   @db.Text
  overallScore   Int      @default(0)
  feedback       Json     @default("{}")
  videoUrl       String?
  audioUrl       String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AlertFreq {
  REALTIME
  DAILY
  WEEKLY
}

model PrivateRoom {
  id          String       @id @default(cuid())
  name        String
  topic       String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members  RoomMember[]
  messages Message[]
}

model RoomMember {
  id       String      @id @default(cuid())
  roomId   String
  userId   String
  role     RoomRole    @default(MEMBER)
  joinedAt DateTime    @default(now())

  room PrivateRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

enum RoomRole {
  OWNER
  MEMBER
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room PrivateRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CompassSession {
  id           String   @id @default(cuid())
  userId       String
  situation    String
  conversation Json     @default("[]")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PitchBuild {
  id             String   @id @default(cuid())
  userId         String
  voiceProfile   Json     @default("{}")
  answers        Json     @default("[]")
  generatedPitch Json     @default("{}")
  score          Int?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnePager {
  id        String   @id @default(cuid())
  userId    String
  input     Json     @default("{}")
  output    Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestorEmail {
  id           String   @id @default(cuid())
  userId       String
  investorName String
  fund         String
  emails       Json     @default("{}")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdeaValidation {
  id        String   @id @default(cuid())
  userId    String
  answers   Json     @default("[]")
  result    Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CofounderProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  skills           Json     @default("[]")
  neededSkills     Json     @default("[]")
  ideaDescription  String
  stage            String
  commitment       String
  locationPref     String?
  equityExpectation String?
  personality      String?
  workStyle        String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FounderChat {
  id        String   @id @default(cuid())
  userId    String
  message   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerSearch {
  id                 String   @id @default(cuid())
  userId             String
  productDescription String   @db.Text
  idealCustomer      String
  problem            String   @db.Text
  industry           String
  results            Json     @default("{}")
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ColdEmailCampaign {
  id          String         @id @default(cuid())
  userId      String
  startupName String
  targetType  String
  goal        String
  emails      Json           @default("[]")
  createdAt   DateTime       @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracking EmailTracking[]
}

model EmailTracking {
  id              String    @id @default(cuid())
  campaignId      String
  userId          String
  recipientName   String
  recipientEmail  String
  emailNumberUsed Int       @default(1)
  status          String    @default("sent")
  notes           String?
  sentAt          DateTime  @default(now())
  repliedAt       DateTime?

  campaign ColdEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model PitchCoachLiveSession {
  id                 String   @id @default(cuid())
  userId             String
  startupName        String
  startupDescription String   @db.Text
  audienceType       String
  targetDuration     Int
  actualDuration     Int      @default(0)
  transcript         String   @db.Text
  wordCount          Int      @default(0)
  fillerWordCount    Int      @default(0)
  wordsPerMinute     Int      @default(0)
  overallScore       Int      @default(0)
  grade              String   @default("")
  analysis           Json     @default("{}")
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
